{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "diagnostics": true, "tsconfig": { "types": ["jest", "chrome", "node", "reflect-metadata"] } }]
  },
  "testRegex": "\\.spec\\.ts$",
  "setupFiles": ["reflect-metadata"],
  "moduleNameMapper": {
    "^@background/(.*)$": "<rootDir>/src/apps/background/$1",
    "^@src/(.*)$": "<rootDir>/src/$1",
    "^@apps/(.*)$": "<rootDir>/src/apps/$1",
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "moduleFileExtensions": ["ts", "tsx", "js", "json"]
}
